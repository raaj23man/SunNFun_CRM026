// Prisma schema file for Travel CRM SaaS
// Specification: TravelCRM_PRD_v2.md (Part 1, Part 2, Part 3 & Part 8)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (PRD Part 1, 2 & 3)
// ==========================================

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_HEAD
  SALES_PERSON
  OPERATIONS
  RESERVATIONS
  DATA_OPERATOR
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ThemePreference {
  LIGHT
  DARK
}

enum DocumentType {
  PASSPORT
  VISA
  NATIONAL_ID
  OTHER
}

enum DocumentUploadSource {
  AGENT
  SELF_SERVICE_LINK
}

enum PlanRequestSource {
  WEBSITE_FORM
  META_ADS
  GOOGLE_ADS
  CHATBOT
  MANUAL
}

enum PlanRequestStatus {
  UNASSIGNED
  ASSIGNED
  CONVERTED_TO_TRIP
  REJECTED
}

enum TripStatus {
  NEW_QUERY
  IN_PROGRESS
  ON_HOLD
  CONVERTED
  COMPLETED
  CANCELLED
  DROPPED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum TripSourceType {
  B2B_AGENT
  DIGITAL_CHANNEL
  DIRECT
  REFERRAL
}

enum SupplierType {
  HOTEL
  TRANSPORT
  ACTIVITY
  DMC
}

enum HotelEntryMethod {
  MANUAL
  FILE_UPLOAD
}

enum OccupancyType {
  SINGLE
  DOUBLE
  TRIPLE
  EXTRA_BED
  PER_UNIT
}

enum TransportBillingMetric {
  PER_SERVICE
  PER_KM
  PER_DAY
}

// ==========================================
// ORGANIZATION & BRAND CORE (PRD Part 1)
// ==========================================

model Organization {
  id                     String   @id @default(uuid())
  company_name           String
  brand_short_name       String
  support_contact_number String
  brand_color_theme      String?
  trip_prefix            String   @default("SBC-")
  logo_url               String?
  header_banner_url      String?
  footer_banner_url      String?
  default_timezone       String   @default("Asia/Kathmandu")
  force_2fa              Boolean  @default(false)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  // Relations
  brands             Brand[]
  billing_addresses  BillingAddress[]
  bank_accounts      BankAccount[]
  users              User[]
  teams              Team[]
  guests             Guest[]
  trip_plan_requests TripPlanRequest[]
  trips              Trip[]
  destinations       TripDestination[]
  trip_sources       TripSource[]
  suppliers          Supplier[]
  hotels             Hotel[]
  rate_sheets        RateSheet[]
  transport_services TransportService[]
  travel_activities  TravelActivity[]
  itineraries        Itinerary[]
  quotes             Quote[]
  tax_types          TaxType[]
  quote_templates    QuoteTemplate[]
  audit_logs         AuditLog[]
  service_bookings   ServiceBooking[]
  vouchers           Voucher[]

  @@map("organizations")
}

model Brand {
  id                   String   @id @default(uuid())
  organization_id      String
  name                 String
  logo_url             String?
  color_theme          String?
  trip_prefix_override String?
  is_default           Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  trips        Trip[]

  @@index([organization_id])
  @@map("brands")
}

model BillingAddress {
  id              String   @id @default(uuid())
  organization_id String
  label           String
  address_text    String
  contact_number  String
  billing_details String? // trade license, VAT/PAN/GST number
  is_primary      Boolean  @default(false)
  destination_id  String? // Nullable - Sembark supports destination-specific addresses
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("billing_addresses")
}

model BankAccount {
  id              String   @id @default(uuid())
  organization_id String
  bank_name       String
  account_number  String
  swift_code      String?
  currency        String   @default("USD")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("bank_accounts")
}

// ==========================================
// USER, TEAM & PERMISSIONS (PRD Part 1)
// ==========================================

model User {
  id                 String          @id @default(uuid())
  organization_id    String
  team_id            String?
  first_name         String
  last_name          String
  email              String          @unique
  password_hash      String?
  phone_number       String?
  role               Role            @default(SALES_PERSON)
  status             UserStatus      @default(ACTIVE)
  last_login         DateTime?
  two_factor_enabled Boolean         @default(false)
  two_factor_secret  String?
  theme_preference   ThemePreference @default(LIGHT)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  // Relations
  organization           Organization             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team                   Team?                    @relation(fields: [team_id], references: [id], onDelete: SetNull)
  permission_overrides   UserPermissionOverride[]
  passkeys               Passkey[]
  assigned_trips         Trip[]                   @relation("AssignedTrips")
  assigned_plan_requests TripPlanRequest[]        @relation("AssignedPlanRequests")
  assigned_follow_ups    FollowUp[]               @relation("UserFollowUps")
  created_tasks          TripTask[]               @relation("CreatedTasks")
  assigned_tasks         TripTask[]               @relation("AssignedTasks")
  audit_logs             AuditLog[]

  @@index([organization_id])
  @@index([team_id])
  @@map("users")
}

model Team {
  id                String   @id @default(uuid())
  organization_id   String
  name              String
  destination_scope String[] @default([]) // Array of destination IDs
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  users        User[]
  trips        Trip[]

  @@index([organization_id])
  @@map("teams")
}

model UserPermissionOverride {
  id             String   @id @default(uuid())
  user_id        String
  permission_key String
  granted        Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission_key])
  @@index([user_id])
  @@map("user_permission_overrides")
}

model Passkey {
  id            String    @id @default(uuid())
  user_id       String
  credential_id String    @unique
  public_key    String
  counter       BigInt    @default(0)
  device_label  String?
  created_at    DateTime  @default(now())
  last_used_at  DateTime?

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("passkeys")
}

// ==========================================
// CRM CORE: GUESTS & DOCUMENTS (PRD Part 2)
// ==========================================

model Guest {
  id                 String   @id @default(uuid())
  organization_id    String
  full_name          String
  phone_number       String
  email              String?
  salutation         String? // e.g. "Mr.", "Mrs.", "Dr."
  is_repeat_traveler Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // Relations
  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  documents    GuestDocument[]
  trips        Trip[]

  @@index([organization_id])
  @@index([phone_number])
  @@index([organization_id, phone_number])
  @@map("guests")
}

model GuestDocument {
  id                String               @id @default(uuid())
  guest_id          String
  document_type     DocumentType
  file_url          String
  expiry_date       DateTime?
  uploaded_via      DocumentUploadSource @default(AGENT)
  upload_link_token String?              @unique
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  // Relations
  guest Guest @relation(fields: [guest_id], references: [id], onDelete: Cascade)

  @@index([guest_id])
  @@map("guest_documents")
}

// ==========================================
// CRM CORE: TRIP PLAN REQUESTS (PRD Part 2)
// ==========================================

model TripPlanRequest {
  id                String            @id @default(uuid())
  organization_id   String
  source            PlanRequestSource @default(MANUAL)
  raw_payload       Json?
  guest_name        String
  phone_number      String
  email             String?
  destination_text  String
  status            PlanRequestStatus @default(UNASSIGNED)
  assigned_user_id  String?
  converted_trip_id String?           @unique
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  // Relations
  organization   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  assigned_user  User?        @relation("AssignedPlanRequests", fields: [assigned_user_id], references: [id], onDelete: SetNull)
  converted_trip Trip?        @relation(fields: [converted_trip_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([status])
  @@index([assigned_user_id])
  @@map("trip_plan_requests")
}

// ==========================================
// CRM CORE: TRIPS / QUERIES (PRD Part 2)
// ==========================================

model Trip {
  id                        String     @id @default(uuid())
  trip_display_id           String     @unique // e.g. "SBC-81881"
  sequence_number           Int // Auto-incrementing sequence per org
  organization_id           String
  brand_id                  String
  team_id                   String?
  assigned_user_id          String
  guest_id                  String
  destination_id            String?
  secondary_destination_id  String?
  start_date                DateTime
  duration_days             Int
  duration_nights           Int
  pax_adults                Int        @default(1)
  pax_children              Int        @default(0)
  origin_city               String?
  trip_source_id            String?
  status                    TripStatus @default(NEW_QUERY)
  is_locked                 Boolean    @default(false)
  is_archived               Boolean    @default(false)
  tags                      String[]   @default([])
  package_amount            Decimal?   @db.Decimal(12, 2)
  currency                  String?    @default("USD")
  created_at                DateTime   @default(now())
  updated_at                DateTime   @updatedAt

  // Relations
  organization          Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  brand                 Brand            @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  team                  Team?            @relation(fields: [team_id], references: [id], onDelete: SetNull)
  assigned_user         User             @relation("AssignedTrips", fields: [assigned_user_id], references: [id], onDelete: Restrict)
  guest                 Guest            @relation(fields: [guest_id], references: [id], onDelete: Restrict)
  destination           TripDestination? @relation("PrimaryDestination", fields: [destination_id], references: [id], onDelete: SetNull)
  secondary_destination TripDestination? @relation("SecondaryDestination", fields: [secondary_destination_id], references: [id], onDelete: SetNull)
  trip_source           TripSource?      @relation(fields: [trip_source_id], references: [id], onDelete: SetNull)
  tourists              Tourist[]
  follow_ups            FollowUp[]
  tasks                 TripTask[]
  trip_plan_request     TripPlanRequest?
  quotes                Quote[]
  service_bookings      ServiceBooking[]
  vouchers              Voucher[]

  @@unique([organization_id, sequence_number])
  @@index([organization_id])
  @@index([status])
  @@index([assigned_user_id])
  @@index([guest_id])
  @@index([destination_id])
  @@index([created_at])
  @@map("trips")
}

model Tourist {
  id                        String   @id @default(uuid())
  trip_id                   String
  full_name                 String
  age                       Int?
  relation_to_primary_guest String?
  assigned_service_ids      String[] @default([])
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  // Relations
  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
  @@map("tourists")
}

model FollowUp {
  id                    String         @id @default(uuid())
  trip_id               String
  assigned_to_user_id   String
  due_date              DateTime
  remarks               String         @db.Text
  status                FollowUpStatus @default(PENDING)
  is_actionable_comment Boolean        @default(true)
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  // Relations
  trip        Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  assigned_to User @relation("UserFollowUps", fields: [assigned_to_user_id], references: [id], onDelete: Restrict)

  @@index([trip_id])
  @@index([assigned_to_user_id])
  @@index([due_date])
  @@index([status])
  @@map("follow_ups")
}

model TripTask {
  id                    String   @id @default(uuid())
  trip_id               String
  created_by_user_id    String
  assigned_to_user_id   String?
  content               String   @db.Text
  is_completed          Boolean  @default(false)
  notify_on_assignment Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Relations
  trip        Trip  @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  created_by  User  @relation("CreatedTasks", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  assigned_to User? @relation("AssignedTasks", fields: [assigned_to_user_id], references: [id], onDelete: SetNull)

  @@index([trip_id])
  @@index([created_by_user_id])
  @@index([assigned_to_user_id])
  @@map("trip_tasks")
}

// ==========================================
// MASTER DATA & CONTRACTING (PRD Part 3)
// ==========================================

model TripDestination {
  id                     String   @id @default(uuid())
  organization_id        String
  name                   String // e.g. "Kathmandu", "Pokhara", "Vietnam"
  image_url              String?
  support_contact_number String?
  child_max_age          Int      @default(10)
  default_checkin_time   String?  @default("14:00")
  default_checkout_time  String?  @default("11:00")
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  // Relations
  organization       Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  primary_trips      Trip[]             @relation("PrimaryDestination")
  secondary_trips    Trip[]             @relation("SecondaryDestination")
  hotels             Hotel[]
  transport_services TransportService[]
  travel_activities  TravelActivity[]
  itineraries        Itinerary[]

  @@index([organization_id])
  @@map("trip_destinations")
}

model Supplier {
  id              String       @id @default(uuid())
  organization_id String
  name            String
  type            SupplierType @default(HOTEL)
  contact_name    String?
  contact_number  String?
  email           String?
  notes           String?      @db.Text
  is_archived     Boolean      @default(false)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // Relations
  organization       Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  hotels             Hotel[]
  transport_services TransportService[]
  travel_activities  TravelActivity[]
  service_bookings   ServiceBooking[]

  @@index([organization_id])
  @@index([type])
  @@map("suppliers")
}

model Hotel {
  id              String           @id @default(uuid())
  organization_id String
  destination_id  String
  supplier_id     String?
  name            String
  star_rating     Int              @default(3)
  address         String?
  website_url     String?
  general_notes   String?          @db.Text
  entry_method    HotelEntryMethod @default(MANUAL)
  is_archived     Boolean          @default(false)
  merged_into_id  String? // Nullable FK for duplicate hotel merging
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  // Relations
  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  destination  TripDestination @relation(fields: [destination_id], references: [id], onDelete: Restrict)
  supplier     Supplier?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  merged_into  Hotel?          @relation("HotelMerges", fields: [merged_into_id], references: [id], onDelete: SetNull)
  merged_from  Hotel[]         @relation("HotelMerges")
  rooms        HotelRoom[]
  service_bookings ServiceBooking[]

  @@index([organization_id])
  @@index([destination_id])
  @@index([supplier_id])
  @@index([name])
  @@map("hotels")
}

model HotelRoom {
  id                  String   @id @default(uuid())
  hotel_id            String
  room_type           String // e.g. "Deluxe Room", "Standard"
  meal_plan           String   @default("CP") // e.g. "EP", "CP", "MAP", "AP"
  max_occupancy       Int      @default(2)
  extra_bed_supported Boolean  @default(true)
  total_room_count    Int? // e.g. 40 (extracted from "40R")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // Relations
  hotel       Hotel       @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  rate_sheets RateSheet[]

  @@index([hotel_id])
  @@map("hotel_rooms")
}

model RateSheet {
  id                   String        @id @default(uuid())
  organization_id      String
  hotel_room_id        String? // Polymorphic-by-nullable-FK
  transport_service_id String?
  activity_id          String?
  season_name          String // e.g. "Peak — Oct-Nov", "Off-Peak"
  valid_from           DateTime
  valid_to             DateTime
  occupancy_type       OccupancyType @default(DOUBLE)
  weekday_price        Decimal       @db.Decimal(12, 2)
  weekend_price        Decimal?      @db.Decimal(12, 2)
  sales_price          Decimal?      @db.Decimal(12, 2) // Sales-team specific rate
  ops_price            Decimal?      @db.Decimal(12, 2) // Ops-team cost rate
  currency             String        @default("USD")
  is_stop_sale         Boolean       @default(false)
  blackout_dates       DateTime[]    @default([])
  is_archived          Boolean       @default(false)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  // Relations
  organization      Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  hotel_room        HotelRoom?        @relation(fields: [hotel_room_id], references: [id], onDelete: Cascade)
  transport_service TransportService? @relation(fields: [transport_service_id], references: [id], onDelete: Cascade)
  travel_activity   TravelActivity?   @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([hotel_room_id])
  @@index([transport_service_id])
  @@index([activity_id])
  @@index([valid_from, valid_to])
  @@map("rate_sheets")
}

model TransportService {
  id              String                 @id @default(uuid())
  organization_id String
  destination_id  String
  supplier_id     String?
  cab_type        String // e.g. "Scorpio SUV", "HiAce 14-Seater", "Sedan"
  capacity        Int                    @default(4)
  billing_metric  TransportBillingMetric @default(PER_DAY)
  closing_days    Int[]                  @default([]) // Weekday integers [0..6]
  is_archived     Boolean                @default(false)
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt

  // Relations
  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  destination  TripDestination @relation(fields: [destination_id], references: [id], onDelete: Restrict)
  supplier     Supplier?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  rate_sheets  RateSheet[]

  @@index([organization_id])
  @@index([destination_id])
  @@index([supplier_id])
  @@map("transport_services")
}

model TravelActivity {
  id              String   @id @default(uuid())
  organization_id String
  destination_id  String
  supplier_id     String?
  name            String // e.g. "Pokhara Paragliding", "Chitwan Jungle Safari"
  ticket_type     String   @default("PER_PERSON") // "PER_PERSON", "PER_BOAT", etc.
  closing_days    Int[]    @default([])
  is_group_priced Boolean  @default(false)
  group_size      Int?     @default(1)
  is_archived     Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  destination  TripDestination @relation(fields: [destination_id], references: [id], onDelete: Restrict)
  supplier     Supplier?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  rate_sheets  RateSheet[]

  @@index([organization_id])
  @@index([destination_id])
  @@index([supplier_id])
  @@map("travel_activities")
}

model Itinerary {
  id              String   @id @default(uuid())
  organization_id String
  destination_id  String
  title           String
  day_number      Int      @default(1)
  description     String   @db.Text
  image_url       String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  destination  TripDestination @relation(fields: [destination_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([destination_id])
  @@map("itineraries")
}

model TripSource {
  id                         String         @id @default(uuid())
  organization_id            String
  name                       String
  type                       TripSourceType @default(DIRECT)
  contact_person             String?
  billing_details            String?        @db.Text
  tags                       String[]       @default([])
  is_primary_contact_flagged Boolean        @default(false)
  is_archived                Boolean        @default(false)
  merged_into_id             String? // Nullable FK for merging
  created_at                 DateTime       @default(now())
  updated_at                 DateTime       @updatedAt

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  merged_into  TripSource?  @relation("TripSourceMerges", fields: [merged_into_id], references: [id], onDelete: SetNull)
  merged_from  TripSource[] @relation("TripSourceMerges")
  trips        Trip[]

  @@index([organization_id])
  @@map("trip_sources")
}

// ==========================================
// PART 4: QUOTATION ENGINE & ITINERARY BUILDER
// ==========================================

enum QuoteStatus {
  DRAFT
  SHARED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PricingStrategy {
  OVERALL
  PER_PERSON
  PER_COMPONENT
  PER_COMPONENT_PER_PERSON
}

enum QuoteItemType {
  HOTEL
  TRANSPORT
  ACTIVITY
  FLIGHT
  CUSTOM
}

enum MarkupType {
  PERCENT
  FLAT
}

enum TaxBasis {
  COST_PLUS_MARKUP
  MARKUP_ONLY
}

enum FlightTripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
  CONNECTING
}

enum FlightEntryMethod {
  API_SEARCH
  MANUAL
}

model Quote {
  id                         String          @id @default(uuid())
  organization_id            String
  trip_id                    String
  version                    Int             @default(1)
  status                     QuoteStatus     @default(DRAFT)
  pricing_strategy           PricingStrategy @default(OVERALL)
  total_cost_price           Decimal         @default(0) @db.Decimal(12, 2)
  total_selling_price        Decimal         @default(0) @db.Decimal(12, 2)
  currency                   String          @default("USD")
  valid_until                DateTime?
  is_multi_option            Boolean         @default(false)
  hide_total_price           Boolean         @default(false)
  include_itinerary          Boolean         @default(true)
  remove_terms               Boolean         @default(false)
  use_similar_hotel_wording  Boolean         @default(false)

  // Overall pricing strategy fields
  overall_markup_type        MarkupType?     @default(PERCENT)
  overall_markup_value       Decimal?        @default(0) @db.Decimal(10, 2)
  overall_tax_rate_id        String?

  created_at                 DateTime        @default(now())
  updated_at                 DateTime        @updatedAt

  // Relations
  organization               Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  trip                       Trip            @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  overall_tax_rate           TaxType?        @relation("QuoteOverallTax", fields: [overall_tax_rate_id], references: [id], onDelete: SetNull)
  options                    QuoteOption[]
  flight_segments            FlightSegment[]

  @@unique([trip_id, version])
  @@index([organization_id])
  @@index([trip_id])
  @@index([status])
  @@map("quotes")
}

model QuoteOption {
  id                  String     @id @default(uuid())
  quote_id            String
  option_label        String     @default("Standard") // e.g. "Deluxe", "Luxury", "Premium"
  is_default          Boolean    @default(true)
  total_cost_price    Decimal    @default(0) @db.Decimal(12, 2)
  total_selling_price Decimal    @default(0) @db.Decimal(12, 2)
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  // Relations
  quote               Quote      @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  days                QuoteDay[]

  @@index([quote_id])
  @@map("quote_options")
}

model QuoteDay {
  id              String       @id @default(uuid())
  quote_option_id String
  day_number      Int          @default(1)
  title           String
  description     String       @db.Text
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // Relations
  quote_option    QuoteOption  @relation(fields: [quote_option_id], references: [id], onDelete: Cascade)
  items           QuoteItem[]

  @@index([quote_option_id])
  @@map("quote_days")
}

model QuoteItem {
  id              String         @id @default(uuid())
  quote_day_id    String
  item_type       QuoteItemType
  inventory_id    String?        // Nullable FK to Hotel/Transport/Activity in master data
  custom_name     String?        // Custom label if manual or freeform
  cost_price      Decimal        @default(0) @db.Decimal(12, 2)
  selling_price   Decimal        @default(0) @db.Decimal(12, 2)
  is_foc          Boolean        @default(false) // Free-of-cost line (selling_price = 0, cost_price retained for margin)
  markup_type     MarkupType?    // PERCENT or FLAT (for PER_COMPONENT*)
  markup_value    Decimal?       @default(0) @db.Decimal(10, 2)
  tax_basis       TaxBasis?      // COST_PLUS_MARKUP or MARKUP_ONLY
  tax_rate_id     String?        // FK to TaxType
  pickup_location String?
  drop_location   String?
  notes           String?        @db.Text
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  // Relations
  quote_day       QuoteDay       @relation(fields: [quote_day_id], references: [id], onDelete: Cascade)
  tax_rate        TaxType?       @relation("ItemTaxRate", fields: [tax_rate_id], references: [id], onDelete: SetNull)
  service_bookings ServiceBooking[]

  @@index([quote_day_id])
  @@index([inventory_id])
  @@index([tax_rate_id])
  @@map("quote_items")
}

model FlightSegment {
  id                  String            @id @default(uuid())
  quote_id            String
  trip_type           FlightTripType    @default(ONE_WAY)
  entry_method        FlightEntryMethod @default(MANUAL)
  airline             String
  flight_number       String
  origin_airport      String
  destination_airport String
  departure_time      DateTime
  arrival_time        DateTime
  travel_class        String            @default("ECONOMY")
  baggage_allowance   String?
  meal_type           String?
  fare_type           String?
  cost_price          Decimal?          @db.Decimal(12, 2)
  selling_price       Decimal?          @db.Decimal(12, 2)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  // Relations
  quote               Quote             @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([quote_id])
  @@map("flight_segments")
}

model TaxType {
  id              String       @id @default(uuid())
  organization_id String
  name            String       // e.g. "GST 5%", "VAT 13%", "TCS 5%", "N/A"
  rate_percent    Decimal      @db.Decimal(5, 2)
  is_inclusive    Boolean      @default(false)
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // Relations
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  quotes          Quote[]      @relation("QuoteOverallTax")
  quote_items     QuoteItem[]  @relation("ItemTaxRate")

  @@index([organization_id])
  @@map("tax_types")
}

model QuoteTemplate {
  id                   String       @id @default(uuid())
  organization_id      String
  name                 String
  font_family          String       @default("Inter")
  section_order        String[]     @default(["GREETING", "ITINERARY", "HOTELS", "FLIGHTS", "PRICING", "INCLUSIONS", "EXCLUSIONS", "TERMS"])
  show_activity_timing Boolean      @default(true)
  is_branded           Boolean      @default(true)
  greeting_rich_text   String?      @db.Text
  header_banner_url    String?
  footer_banner_url    String?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  // Relations
  organization         Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("quote_templates")
}

// ==========================================
// PART 8: AUDIT LOGGING & GOVERNANCE
// ==========================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
}

model AuditLog {
  id              String       @id @default(uuid())
  organization_id String
  actor_user_id   String?
  entity_type     String       // e.g. "Hotel", "RateSheet", "TransportService", "Quote", "Trip", "FinancialTransaction"
  entity_id       String
  action          AuditAction
  diff            Json?        // Before/after changed fields
  created_at      DateTime     @default(now())

  // Relations
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  actor_user      User?        @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

// ==========================================
// PART 5: OPERATIONS, DISPATCH & SMART CALENDARS
// ==========================================

enum ServiceBookingStatus {
  PENDING_CONFIRMATION
  ENQUIRY_SENT
  CONFIRMED
  VOUCHER_GENERATED
  CHANGED
  DROPPED
  CANCELLED
}

enum VoucherType {
  HOTEL
  TRANSPORT
  ACTIVITY
  TRIP
}

model ServiceBooking {
  id                             String               @id @default(uuid())
  organization_id                String
  trip_id                        String
  quote_item_id                  String?
  supplier_id                    String?
  hotel_id                       String?
  service_type                   QuoteItemType        @default(HOTEL)
  service_name                   String
  status                         ServiceBookingStatus @default(PENDING_CONFIRMATION)
  supplier_confirmation_number   String?
  cost_price                     Decimal              @default(0) @db.Decimal(12, 2)
  selling_price                  Decimal              @default(0) @db.Decimal(12, 2)
  amount_paid                    Decimal              @default(0) @db.Decimal(12, 2)
  is_self_booked                 Boolean              @default(false)
  service_date                   DateTime
  check_in_date                  DateTime?
  check_out_date                 DateTime?
  room_count                     Int                  @default(1)
  pax_count                      Int                  @default(2)
  meal_plan                      String?              @default("CP")
  payment_preference_rule_id     String?
  payment_due_date               DateTime?
  drop_cancellation_charge       Decimal?             @db.Decimal(12, 2)
  replaced_by_service_booking_id String?              // FK chaining a "change"
  notes                          String?              @db.Text
  created_at                     DateTime             @default(now())
  updated_at                     DateTime             @updatedAt

  // Relations
  organization                   Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  trip                           Trip                 @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  quote_item                     QuoteItem?           @relation(fields: [quote_item_id], references: [id], onDelete: SetNull)
  supplier                       Supplier?            @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  hotel                          Hotel?               @relation(fields: [hotel_id], references: [id], onDelete: SetNull)
  replaced_by                    ServiceBooking?      @relation("ServiceBookingChaining", fields: [replaced_by_service_booking_id], references: [id], onDelete: SetNull)
  replaces                       ServiceBooking[]     @relation("ServiceBookingChaining")
  dispatch_assignment            DispatchAssignment?
  vouchers                       Voucher[]

  @@index([organization_id])
  @@index([trip_id])
  @@index([supplier_id])
  @@index([hotel_id])
  @@index([status])
  @@index([service_date])
  @@index([check_in_date, check_out_date])
  @@map("service_bookings")
}

model DispatchAssignment {
  id                 String         @id @default(uuid())
  service_booking_id String         @unique
  driver_name        String
  driver_phone       String
  cab_type           String
  vehicle_number     String
  pickup_time        DateTime?
  pickup_location    String?
  drop_location      String?
  notes              String?        @db.Text
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  // Relations
  service_booking    ServiceBooking @relation(fields: [service_booking_id], references: [id], onDelete: Cascade)

  @@map("dispatch_assignments")
}

model Voucher {
  id                         String         @id @default(uuid())
  organization_id            String
  trip_id                    String
  service_booking_id         String?        // Nullable if type === TRIP
  type                       VoucherType    @default(HOTEL)
  voucher_code               String         // Unique code, e.g. "VCH-10001-H1"
  pdf_url                    String?        // Signed S3 URL
  qr_code_data               String?        // For activity/trip vouchers
  is_edited_after_generation Boolean        @default(false)
  custom_content             Json?          // Stores customized section overrides
  generated_at               DateTime       @default(now())
  created_at                 DateTime       @default(now())
  updated_at                 DateTime       @updatedAt

  // Relations
  organization               Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  trip                       Trip           @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  service_booking            ServiceBooking? @relation(fields: [service_booking_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, voucher_code])
  @@index([organization_id])
  @@index([trip_id])
  @@index([service_booking_id])
  @@map("vouchers")
}



